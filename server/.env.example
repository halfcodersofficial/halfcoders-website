# ============================================
# Half Coders Backend — copy to .env and fill in
# ============================================
# Half Coders has its own accounts (email + password) and its own database.

# ----- Environment -----
NODE_ENV=development
PORT=5001

# ----- URLs -----
# FRONTEND_URL is where links in emails, certificates and invoices point.
# Keep localhost only while mail is logged rather than sent. Once this server
# sends real mail, or uses the live database, set it to the live site
# (https://half-coders.tech): a localhost link opens nothing for whoever gets
# the email. The local site at localhost:3001 keeps working either way — in
# development it's always allowed in. In production, localhost won't boot.
FRONTEND_URL=http://localhost:3001
BACKEND_URL=http://localhost:5001

# Production only, when the web app and the API are on sibling subdomains
# (half-coders.tech on Vercel, api.half-coders.tech on Render): the parent
# domain, so the session cookie reaches both. Leave unset locally.
# COOKIE_DOMAIN=half-coders.tech

# Proxies between the internet and the API (default 1). If "My devices"
# shows a proxy's IP instead of yours, raise it by one.
# TRUST_PROXY=1

# ============================================
# DATABASE — REQUIRED
# ============================================
# Half Coders' own PostgreSQL database, ending with ?schema=learning (every
# table and the migration history live in that schema; boot fails without
# it). Then `pnpm migrate:deploy` — the server seeds the rest when it starts.
# For local development, `pnpm db:up` starts a PostgreSQL container that
# matches these two URLs exactly (docker-compose.dev.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/halfcoders?schema=learning
# Optional: the direct (unpooled) connection for migrations. Without it, a
# Neon `-pooler` host in DATABASE_URL is turned into its direct one — Prisma's
# migration lock can get stuck behind a pooler (prisma.config.ts).
# DIRECT_DATABASE_URL=

# Only for `pnpm migrate <name>` (creating migrations): an EMPTY scratch
# database Prisma may freely wipe. Never the real database.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/halfcoders_shadow?schema=learning

# Optional — without it the rate limiters use an in-process store.
# REDIS_URL=redis://localhost:6379

# ============================================
# ACCOUNTS — REQUIRED
# ============================================
# Keys the one-time codes mailed for email verification and password resets.
# At least 32 random characters, e.g. `openssl rand -base64 36`.
AUTH_SECRET=

# Sign in with Google (optional): the OAuth client from Google Cloud →
# APIs & Services → Credentials ("Web application"). The id is the same as the
# web app's NEXT_PUBLIC_GOOGLE_CLIENT_ID; the secret stays here only — it
# trades the code from Google's sign-in popup for the account. No redirect URI
# is needed in Google Cloud, only the site's JavaScript origins. Empty turns
# it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The first super admin — created when the server starts, if no account has
# this email yet (an existing one is never changed; `pnpm seed:admin` promotes
# it). A password with a `#` must be quoted: SUPER_ADMIN_PASSWORD='a#b...'.
SUPER_ADMIN_NAME=Half Coders Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# ============================================
# EMAIL — REQUIRED (Brevo API or SMTP)
# ============================================
# Brevo (brevo.com): mail goes over HTTPS, so it works on hosts that block
# the SMTP ports — Render's and Railway's free plans. Set the key and FROM
# (an address on the domain authenticated in Brevo, e.g.
# `Half Coders <no-reply@half-coders.tech>`); the SMTP login below is then
# not needed. Leave the key empty to send by SMTP.
EMAIL_SENDER_BREVO_API_KEY=
#
# SMTP — Gmail: use an App Password, not the account password. Gmail sends
# only from the signed-in account, so FROM uses the same address as USER.
EMAIL_SENDER_SMTP_USER=halfcoders.official@gmail.com
EMAIL_SENDER_SMTP_PASS=
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=465
EMAIL_SENDER_SMTP_FROM=Half Coders <halfcoders.official@gmail.com>

# ============================================
# CLOUDINARY (file uploads) — REQUIRED
# ============================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Top-level folder for Half Coders' uploads (default: halfcoders). It only ever
# deletes files under this folder.
# CLOUDINARY_FOLDER=halfcoders

# ============================================
# STAFF ACCOUNTS
# ============================================
# The first SUPER_ADMIN is created on boot from SUPER_ADMIN_* (above). Admins
# and mentors are then created from the Half Coders admin console.

# ============================================
# OPTIONAL
# ============================================
LOG_LEVEL=debug
UPLOAD_SIZE_LIMIT=2MB
