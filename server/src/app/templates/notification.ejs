<!doctype html>
<html>
<body style="margin:0;padding:0;background:#f4f6f8;font-family:Segoe UI,Roboto,Helvetica,Arial,sans-serif;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="padding:32px 12px;">
    <tr>
      <td align="center">
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0"
               style="max-width:520px;background:#ffffff;border-radius:12px;padding:32px;">
          <tr>
            <td style="font-size:13px;font-weight:700;letter-spacing:1px;color:#6022cf;padding-bottom:12px;">HALF CODERS</td>
          </tr>
          <tr>
            <td style="font-size:19px;font-weight:700;color:#0f172a;padding-bottom:12px;"><%= title %></td>
          </tr>
          <tr>
            <td style="font-size:15px;color:#334155;line-height:1.6;padding-bottom:24px;"><%= message %></td>
          </tr>
          <% if (locals.actionUrl) { %>
          <tr>
            <td align="center">
              <a href="<%= actionUrl %>"
                 style="display:inline-block;background:#6022cf;color:#ffffff;text-decoration:none;
                        font-size:15px;font-weight:600;padding:12px 28px;border-radius:8px;">
                <%= locals.actionLabel || "Open Half Coders" %>
              </a>
            </td>
          </tr>
          <% } %>
          <% if (locals.settingsUrl) { %>
          <tr>
            <td style="font-size:12px;color:#94a3b8;line-height:1.5;padding-top:28px;">
              You're getting this because email updates are on for your Half Coders account.
              <a href="<%= settingsUrl %>" style="color:#64748b;">Turn them off in Settings</a>.
            </td>
          </tr>
          <% } %>
        </table>
      </td>
    </tr>
  </table>
</body>
</html>
