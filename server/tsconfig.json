{
  "compilerOptions": {
    // CommonJS so Node 22 resolves the extension-less, directory-style relative
    // imports used throughout (e.g. `import app from "./app"`). With
    // "module": "esnext" Node treats built files as native ESM and throws
    // ERR_UNSUPPORTED_DIR_IMPORT.
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2023",
    "rootDir": "./",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "ignoreDeprecations": "5.0"
  },
  "include": [
    "src",
    "scripts",
    "prisma.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
