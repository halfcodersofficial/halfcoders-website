# =============================================================================
# Half Coders API — production image
#
# Multi-stage so the runtime layer carries no toolchain and no source: build
# with dev dependencies, then copy only `dist`, the pruned production modules
# and the generated Prisma client into a clean base.
# =============================================================================
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate
WORKDIR /app

# ---- deps ------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# ---- build -----------------------------------------------------------------
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY . .
# The client must be generated before tsc: the whole codebase imports its types.
RUN pnpm generate && pnpm build

# ---- production deps -------------------------------------------------------
FROM base AS prod-deps
COPY package.json pnpm-lock.yaml ./
COPY prisma ./prisma
COPY prisma.config.ts ./
RUN pnpm install --frozen-lockfile --prod

# ---- runtime ---------------------------------------------------------------
FROM node:22-alpine AS runtime
RUN corepack enable && corepack prepare pnpm@10.32.1 --activate

# dumb-init reaps zombies and forwards SIGTERM, so the graceful shutdown in
# server.ts actually runs instead of the container being killed outright.
RUN apk add --no-cache dumb-init curl

ENV NODE_ENV=production
WORKDIR /app

COPY --from=prod-deps /app/node_modules ./node_modules
COPY --from=build     /app/dist         ./dist
COPY --from=build     /app/src/generated ./src/generated
COPY --from=build     /app/src/app/templates ./src/app/templates
# Fonts for the generated PDFs (utils/pdfText.ts) — read from disk at runtime, like the templates.
COPY --from=build     /app/src/app/assets ./src/app/assets
COPY prisma ./prisma
COPY prisma.config.ts package.json ./

# Never run as root.
RUN addgroup -g 1001 -S nodejs && adduser -S halfcoders -u 1001 && chown -R halfcoders:nodejs /app
USER halfcoders

EXPOSE 5001

# Readiness, not liveness: 503 until the database answers, so the orchestrator
# doesn't route traffic at a process that can't serve it.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS http://127.0.0.1:5001/readiness || exit 1

ENTRYPOINT ["dumb-init", "--"]
CMD ["node", "dist/src/server.js"]
