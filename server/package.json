{
  "name": "halfcoders-backend",
  "version": "1.0.0",
  "description": "Half Coders — Online Learning & Training Platform API",
  "main": "dist/src/server.js",
  "scripts": {
    "start": "node dist/src/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint \"./src/**/*.ts\"",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "migrate": "tsx scripts/new-migration.ts",
    "migrate:deploy": "tsx scripts/prepare-learning-schema.ts && prisma migrate deploy",
    "migrate:prod": "node dist/scripts/prepare-learning-schema.js && prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "generate": "prisma generate",
    "studio": "prisma studio",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "seed:admin:prod": "node dist/scripts/seed-admin.js",
    "seed:categories": "tsx scripts/seed-categories.ts",
    "seed:categories:prod": "node dist/scripts/seed-categories.js",
    "seed:catalogue": "tsx scripts/seed-initial-catalogue.ts",
    "seed:catalogue:prod": "node dist/scripts/seed-initial-catalogue.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:test": "tsc -p test/tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "keywords": [
    "halfcoders",
    "lms",
    "elearning"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "ejs": "^4.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.1.0",
    "http-status": "^2.1.0",
    "ioredis": "^5.6.1",
    "ms": "^2.1.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.3.0",
    "qs": "^6.14.1",
    "rate-limit-redis": "^4.2.0",
    "socket.io": "^4.8.3",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.2.0",
    "@types/nodemailer": "^7.0.9",
    "@types/pdfkit": "^0.17.5",
    "@types/pg": "^8.16.0",
    "@types/qs": "^6.14.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.2",
    "supertest": "^7.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  }
}
