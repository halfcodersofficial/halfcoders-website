# Base URL of the Half Coders API. Must match the backend's BACKEND_URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/api/v1

# Origin the Socket.IO client connects to for live support-queue updates
# (the backend serves sockets on the same port as the REST API).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5001

NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_SITE_NAME=Half Coders
