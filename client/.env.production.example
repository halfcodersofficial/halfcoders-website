# Half Coders web — production (Vercel → Settings → Environment Variables, for
# Production). NEXT_PUBLIC_* are inlined at build time: change one, redeploy.
#
# The API answers on a subdomain of this site (api.half-coders.tech on Render,
# with COOKIE_DOMAIN=half-coders.tech there), so the session cookie is
# first-party to both — see ../server/README.md, "Deployment".
NEXT_PUBLIC_API_BASE_URL=https://api.half-coders.tech/api/v1
NEXT_PUBLIC_SOCKET_URL=https://api.half-coders.tech
NEXT_PUBLIC_SITE_URL=https://half-coders.tech
NEXT_PUBLIC_SITE_NAME=Half Coders
# "Continue with Google": the OAuth client id, the same as the API's
# GOOGLE_CLIENT_ID on Render. Empty hides the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Blocks DevTools, the console and right-click on the live site. The Docker
# image turned it on by itself; on Vercel it has to be set.
NEXT_PUBLIC_ENABLE_DEVTOOLS_PROTECTION=true
